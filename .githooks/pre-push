#!/bin/sh

# Blocca il push di tag che non puntano a un commit di main: il workflow di
# release parte al push del tag e deve pubblicare solo codice già su main.
input=$(cat)
zero=0000000000000000000000000000000000000000
if printf '%s\n' "$input" | grep -q ' refs/tags/'; then
	git fetch -q "$1" main || { echo >&2 "pre-push: impossibile aggiornare main da $1"; exit 1; }
fi
printf '%s\n' "$input" | while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
	refs/tags/*)
		[ "$local_sha" = "$zero" ] && continue # cancellazione del tag
		if ! git merge-base --is-ancestor "$local_sha^{commit}" FETCH_HEAD; then
			echo >&2 "pre-push: il tag ${remote_ref#refs/tags/} non punta a un commit di main, push annullato"
			exit 1
		fi
		;;
	esac
done || exit 1

command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
printf '%s\n' "$input" | git lfs pre-push "$@"
